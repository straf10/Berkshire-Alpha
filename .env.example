APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
FEATHERLESS_API_KEY=
ALPACA_CLI_PATH=alpaca
AGENT_DB_PATH=./agent.db
EQUITY_FEED=auto
WEB_ORIGIN=https://<your-vercel-app>.vercel.app
TZ=UTC
# Day 3 (docs/day3-llm-plan.md S1d) -- must be set on Railway before D2, or
# the container starts and the LLM layer immediately degrades to quant-only.
LLM_PROVIDER=featherless
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=options-alpha-agent/0.1
